# Real live-pilot configuration. Copy this file to .env locally; never commit it.
LIVE_ENABLED=true
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres
GEOAPIFY_API_KEY=your_geoapify_key
APP_BASE_URL=http://127.0.0.1:8000
COOKIE_SECURE=false

# Optional password-recovery email. On Render free instances, use Resend's HTTPS
# API because outbound SMTP ports are blocked. Gmail SMTP requires an app password.
# RESEND_API_KEY=re_...
# MAIL_FROM=ZENIT <onboarding@resend.dev>
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your-16-character-gmail-app-password
# SMTP_FROM=you@gmail.com
